# ─── Base de données PostgreSQL (Docker Compose en local) ────────────────────
DATABASE_URL="postgresql://edukdo:edukdo_dev_password@localhost:5432/edukdo_db"

# ─── Redis (queues de jobs Bull) ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT — utiliser des secrets forts en production (openssl rand -base64 64) ─
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_USE_STRONG_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_REFRESH_IN_PRODUCTION"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── AWS (laisser vide en développement pour utiliser les mocks) ─────────────
AWS_REGION="eu-west-3"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="edukdo-bulletins-dev"

# ─── Anthropic Claude API ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=""

# ─── Configuration de l'API ──────────────────────────────────────────────────
API_PORT=3000
NODE_ENV="development"

# ─── URL de l'API (utilisée par l'app mobile) ────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:3000"
